# Thalos — centralized environment configuration
#
# Copy this file to `.env` and edit values. The backend (thalos_api) loads it
# automatically via dotenvy; the web app reads Vite variables from `web/.env`
# (see web/.env.example). Existing shell variables always win over this file.
#
# Do NOT commit real `.env` files. `.env` is gitignored; only this example
# is versioned.

# ── Backend (thalos_api) ─────────────────────────────────────────────────

# Log level (tracing_subscriber::EnvFilter). Values: error, warn, info,
# debug, trace. Default when unset: info
RUST_LOG=info

# Feature flag: enable Apply/Undo scene write-back (SDD block 4). OFF by
# default — rollback-safe. Accepted values: 1/true/yes/on (case-insensitive).
# Any other value disables the flag. Read only at process startup.
THALOS_SCENE_WRITEBACK=false

# Command history capacity (positive integer). Default: 100. Invalid or
# non-positive values fall back to the default.
THALOS_HISTORY_CAP=100

# Execution backend selection. Set to `esp32` to register the Esp32 hardware
# backend; leave empty/unset for the simulation backend. Requires
# THALOS_SERIAL_PORT to be set as well.
THALOS_EXECUTION_BACKEND=

# Serial port for the Esp32 backend, e.g. /dev/ttyUSB0 or COM3.
THALOS_SERIAL_PORT=

# Demos catalog root (repo-relative by default). Default: ./demos
THALOS_DEMOS_ROOT=./demos

# SAFETY ESCAPE HATCH. Set to 1 to skip the python3 safety parity gate.
# CI NEVER sets this. Leave unset unless debugging locally.
THALOS_ALLOW_PARITY_SKIP=

# ── esp-simulator example ────────────────────────────────────────────────
# Used by: cargo run -p thalos_runtime --example esp-simulator
# CLI flags (--scenario/--port/--samples) override these variables.

# Simulated ESP32 scenario: happy | error | silence. Default: happy
ESP_SIM_SCENARIO=happy

# Simulated serial port number. Default: 7000
ESP_SIM_PORT=7000

# Number of samples to emit. Default: 10
ESP_SIM_SAMPLES=10

# ── Web (Vite) ───────────────────────────────────────────────────────────
# Vite reads web/.env automatically; keep VITE_ variables there, not here.
# See web/.env.example. Default: /api/v1 (proxied to localhost:3000 in dev)
# VITE_API_BASE=

# ── System-managed (do not set here) ─────────────────────────────────────
# XDG_DATA_HOME / HOME — session storage location (.thalos/sessions).
# Managed by the OS/shell; setting them here would break paths.
