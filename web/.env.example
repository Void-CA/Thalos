# Thalos web — environment variables (Vite convention)
#
# Vite loads `web/.env` automatically. Copy this file to `.env` (or `.env.local`
# for machine-local overrides, which is gitignored) and edit.
#
# Absolute backend base URL. Default when unset: /api/v1
# (proxied to http://localhost:3000 in dev — see vite.config.ts)
VITE_API_BASE=/api/v1
